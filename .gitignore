# ─────────────────────────────────────────────────────────────────────────────
# DONNÉES PERSONNELLES — ne jamais versionner.
#
# Les règles sont volontairement GLOBALES et non limitées à un dossier : les
# relevés qui ont fui une fois (`UBS.csv`, `Creditmut.csv`) étaient à la racine,
# pas dans « csv files/ ». Un motif par chemin ne protège que le chemin auquel on
# a pensé.
#
# Si un CSV doit vraiment être versionné (jeu de test), c'est un acte conscient :
#   git add -f chemin/vers/fixture.csv
# ─────────────────────────────────────────────────────────────────────────────

# Relevés bancaires et exports, où qu'ils soient
*.csv

# Bases SQLite : base vive, sauvegardes, copies de test, journaux WAL
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Dossiers de données (base + sauvegardes + journaux)
backend/data/
release/data/
web/e2e/.tmp-data/

# Export de diagnostic — contient une queue de journal (noms de fichiers importés)
diagnostics*.json

# Secrets et configuration d'environnement
.env*
!.env.example

# Pickles : le sous-système ML a été retiré, mais un .pkl est presque toujours
# un vidage de données. La règle reste, par précaution.
*.pkl

# Notes de travail personnelles
csv files/
autre/
CLAUDE.md

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
*.egg-info/
dist/
build/
.pytest_cache/

# Frontend
web/node_modules/
web/.next/
web/test-results/
web/playwright-report/
web/*.tsbuildinfo
# Next artefacts égarés hors de web/ (un build lancé depuis le mauvais dossier)
.next/

# macOS
.DS_Store

# IDE
.vscode/
.idea/
